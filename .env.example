# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ---- Postgres (Supabase) ----
DB_NAME=                          # jdbc:postgresql://<host>:<port>/<db>  (no embedded user:pass — use DB_USER/DB_PASS below)
                                   # If using Supabase's transaction-mode pooler (port 6543), append
                                   # ?prepareThreshold=0 — the JDBC driver's server-side prepared
                                   # statement cache breaks under PgBouncer transaction pooling
                                   # ("prepared statement already exists" errors) otherwise.
DB_USER=
DB_PASS=

# ---- Redis (cloud, e.g. Upstash free tier) ----
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false                   # set true for Upstash (TLS-only) — leave false for local/plain Redis

# ---- Storage: Cloudflare R2 (S3-compatible) ----
STORAGE_ENDPOINT=                  # R2 S3 API endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=

# ---- JWT ----
JWT_SECRET=                       # generate: openssl rand -base64 32

# ---- App ----
APP_FRONTEND_URL=
CORS_ALLOWED_ORIGINS=*

# ---- Admin bootstrap ----
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_PASSWORD=         # generate: openssl rand -base64 18
